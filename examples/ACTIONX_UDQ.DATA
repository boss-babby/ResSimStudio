 514.7 6.274 0.0112
 1014.7 3.197 0.014
 2014.7 1.614 0.0189
 2514.7 1.294 0.0208
 3014.7 1.08 0.0228
 4014.7 0.811 0.0268
 5014.7 0.649 0.0309
 9014.7 0.386 0.047
/

SWOF
 0.20 0.0    1.0   0
 0.25 0.005  0.80  0
 0.30 0.02   0.62  0
 0.35 0.045  0.46  0
 0.40 0.08   0.33  0
