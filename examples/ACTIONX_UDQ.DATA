 0.7 0.94 0 0
 0.85 0.98 0 0
 0.88 0.984 0 0
/

SOLUTION

EQUIL
 8400 4600 8900 0 8300 0 1 1* 0 /

RSVD
 7300 1.27
 9450 1.27
/

SUMMARY

FOPR
FWPR
FWIR
FOPT
FPR
FWCT
WOPR
 'P*' /
WWCT
 'P*' /
WWIR
 'I1' /
FUWCT
FUINJ
FUPLIM

SCHEDULE

TUNING
 1 30 /
/
/

WELSPECS
 'P1' 'G1' 3 3 8400 OIL /
 'P2' 'G1' 11 1 8400 OIL /
 'P3' 'G1' 1 11 8400 OIL /
 'P4' 'G1' 11 11 8400 OIL /
 'I1' 'G1' 6 6 8400 WATER /
/

COMPDAT
 'P*' 2* 1 3 OPEN 1* 1* 0.5 /
 'I1' 2* 1 3 OPEN 1* 1* 0.5 /
/

UDQ
-- field water cut (also written to the summary as FUWCT)
 DEFINE FUWCT FWPR / (FWPR + FOPR) /
-- injection target: the produced reservoir volume (voidage replacement 1.05) + 500 stb/d
 DEFINE FUINJ 1.05 * FVPR + 500 /
-- producer oil-rate limit (raised by the action PRESSURE)
 ASSIGN FUPLIM 1500 /
 UNITS FUWCT 'frac' /
 UNITS FUINJ 'STB/DAY' /
 UNITS FUPLIM 'STB/DAY' /
/

WCONPROD
 'P*' OPEN ORAT 'FUPLIM' 4* 1000 /
/

WCONINJE
 'I1' WATER OPEN RATE 'FUINJ' 1* 6000 /
/

ACTIONX
 WCUT 4 /
  WWCT 'P*' > 0.8 /
/
WELOPEN
 '?' SHUT /
/
ENDACTIO

ACTIONX
 PRESSURE 1 /
 FPR > 5300 AND
 DAY >= 1 /
/
UDQ
 ASSIGN FUPLIM 2200 /
/
WELTARG
 'I1' BHP 5800 /
/
ENDACTIO

TSTEP
 10 20 30 30 24*60
/

END
